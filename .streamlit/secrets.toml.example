# Copia este archivo a .streamlit/secrets.toml (SIN el .example) para probar el modo nube
# en tu computador. En Streamlit Community Cloud, estos mismos dos valores se pegan en
# Settings → Secrets del panel de la app — nunca se sube este archivo a GitHub
# (ya está en .gitignore, incluso el .toml sin .example).
#
# Sin estos dos valores, la app funciona en modo local normal, sin login: no hace falta
# nada de esto para tu uso personal de siempre.

TURSO_DATABASE_URL = "libsql://tu-base.turso.io"
TURSO_AUTH_TOKEN = "el-token-que-te-da-turso"
